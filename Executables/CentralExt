                    print(f"Resource adjustment for analytical:")
                    print(f"  Original: mem={mem}, nprocs={nprocs}")
                    print(f"  Adjusted: mem={adjusted_mem}, nprocs={adjusted_nprocs}")

                    analytical_args = [
                        analytical_preamble, ending_file, adjusted_nprocs,
                        adjusted_mem, 'READ', layer
                    ]

                # Run analytical gradient calculation using external program
                print(f"INFO: Running analytical gradient calculation with {len(analytical_indices)} section(s)")

                # Read analytical preamble content
                with open(analytical_preamble, 'r') as f:
