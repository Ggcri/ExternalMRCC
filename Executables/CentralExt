                sys.exit(1)
        print(f"DEBUG: All geometries have correct atom count ({atoms})")

        # ========================================================================
        # MIXED MODE BRANCHING: Handle analytical and/or numerical workflows
        # ========================================================================

        if mixed_mode or all_analytical_mode:
            print("\n" + "="*80)
            print("MIXED/ANALYTICAL MODE: Splitting preamble and running workflows")
            print("="*80)

            # Parse scheme and formula from preamble
            operations, formula = parse_scheme_and_formula(preamble_file, program=program_key)
            print(f"Parsed {len(operations)} operations from scheme")
            if formula:
                print(f"Custom formula detected: {formula}")

            # Split preamble file
